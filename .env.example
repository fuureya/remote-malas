# Wajib: Masukkan Token Bot Telegram yang Anda dapatkan dari BotFather (@BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCDEFGHIJKLMNOPQRSTUVWXYZ

# ---------------- HAK AKSES (WHITELIST) ----------------
# Jika dikosongkan, bot secara default akan merespons di semua chat/pengguna

# Batasan Pengguna (User ID)
# Untuk mendapatkan User ID Anda, kirim pesan ke bot @userinfobot di Telegram
ALLOWED_USER_IDS=123456789,987654321

# Batasan Grup/Chat (Chat ID)
# Jika Anda menambahkan bot ke grup chat, ID grup biasanya diawali dengan tanda minus (-).
# Contoh: -1001234567890 adalah ID grup "My Private Group"
ALLOWED_CHAT_IDS=

# ---------------- KONFIGURASI SANDBOX & AGEN ----------------
ANTIGRAVITY_CMD=agy

# Sandbox Dirs: Direktori aman pada server yang diizinkan untuk dikelola oleh Bot.
# SANGAT PENTING: Bot TIDAK AKAN BISA mengakses folder di luar direktori ini.
ALLOWED_DIRS=/path/to/your/projects,/var/www/html